{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spendy2-docs",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "route": {
    "pattern": "docs.spendy2.com",
    "custom_domain": true,
  },
}
