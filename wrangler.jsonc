{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spendy2",
  "compatibility_date": "2026-10-07",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "durable_objects": {
    "bindings": [{ "name": "USER", "class_name": "UserStore" }],
  },
  "exports": {
    "UserStore": { "type": "durable-object", "storage": "sqlite" },
  },
  "vars": {
    "LOGIN_BACKOFF_MAX_SECONDS": 16,
    "USER_CLEANUP_DELAY_SECONDS": 86400,
    "MAX_SESSIONS_PER_USER": 10,
    "MAX_DATABASE_UPLOAD_BYTES": 20971520,
  },
  "secrets": {
    "required": [
      "OPAQUE_SERVER_SETUP",
      "S3_ENDPOINT",
      "S3_REGION",
      "S3_BUCKET",
      "S3_ACCESS_KEY_ID",
      "S3_SECRET_ACCESS_KEY",
    ],
  },
  "route": {
    "pattern": "spendy2.com",
    "custom_domain": true,
  },
}
